+async fn native_api_prepare_agent_spawn_config_resets_effort_and_service_tier_impl() -> anyhow::Result<()> {
+    let (home, mut config) = test_config().await;
+    let _ = config.features.enable(Feature::MultiAgentV2);
+    config.model = Some("gpt-5.6-sol".to_string());
+    config.model_reasoning_effort = Some(ReasoningEffort::XHigh);
+    config.service_tier = Some("flex".to_string());
+    config.web_search_mode = Constrained::allow_any(WebSearchMode::Cached);
+    let (role, provider_id, _catalog, provider) =
+        configure_native_api_profile(&home, &mut config, NATIVE_API_MODEL, Some("medium"), true);
+    let harness = AgentControlHarness::new_with_config(home, config.clone()).await;
+    let (_root_id, thread) = harness.start_thread().await;
+    let root_before = thread.session.get_config().await;
+    assert_eq!(root_before.service_tier.as_deref(), Some("flex"));
+    assert_eq!(root_before.web_search_mode.value(), WebSearchMode::Cached);
+    let turn = thread.session.new_default_turn().await;
+    let step_context = StepContext::for_test(Arc::clone(&turn));
+
+    let requested = prepare_agent_spawn_config(
+        thread.session.as_ref(),
+        &step_context,
+        SpawnConfigOptions {
+            version: SpawnConfigVersion::V2,
+            full_history_fork: false,
+            role_name: Some(&role),
+            model: None,
+            reasoning_effort: Some(ReasoningEffort::High),
+        },
+    )
+    .await
+    .expect("native API profile spawn config should prepare");
+    assert_eq!(requested.role_name.as_deref(), Some(role.as_str()));
+    assert_eq!(requested.config.model.as_deref(), Some(NATIVE_API_MODEL));
+    assert_eq!(requested.config.model_provider_id, provider_id);
+    assert_eq!(requested.config.model_provider, provider);
+    assert_eq!(
+        requested.config.model_reasoning_effort,
+        Some(ReasoningEffort::High)
+    );
+    assert_eq!(requested.config.service_tier, None);
+    assert_eq!(
+        requested.config.web_search_mode.value(),
+        WebSearchMode::Disabled
+    );
+    assert_eq!(
+        requested.config.model_catalog.as_ref().unwrap().models[0].slug,
+        NATIVE_API_MODEL
+    );
+
+    let role_default = prepare_agent_spawn_config(
+        thread.session.as_ref(),
+        &step_context,
+        SpawnConfigOptions {
+            version: SpawnConfigVersion::V2,
+            full_history_fork: false,
+            role_name: Some(&role),
+            model: None,
+            reasoning_effort: None,
+        },
+    )
+    .await
+    .expect("role default effort should prepare");
+    assert_eq!(
+        role_default.config.model_reasoning_effort,
+        Some(ReasoningEffort::Medium)
+    );
+    assert_eq!(role_default.config.service_tier, None);
+    assert_eq!(
+        role_default.config.web_search_mode.value(),
+        WebSearchMode::Disabled
+    );
+
+    let model_error = prepare_agent_spawn_config(
+        thread.session.as_ref(),
+        &step_context,
+        SpawnConfigOptions {
+            version: SpawnConfigVersion::V2,
+            full_history_fork: false,
+            role_name: Some(&role),
+            model: Some("different-model"),
+            reasoning_effort: None,
+        },
+    )
+    .await
+    .err()
+    .expect("native API profile model override must fail");
+    assert!(model_error.contains("omit the model override"));
+
+    let effort_error = prepare_agent_spawn_config(
+        thread.session.as_ref(),
+        &step_context,
+        SpawnConfigOptions {
+            version: SpawnConfigVersion::V2,
+            full_history_fork: false,
+            role_name: Some(&role),
+            model: None,
+            reasoning_effort: Some(ReasoningEffort::Ultra),
+        },
+    )
+    .await
+    .err()
+    .expect("unsupported native API effort must fail");
+    assert!(effort_error.contains("not supported"));
+
+    let root_after = thread.session.get_config().await;
+    assert_eq!(root_after.model.as_deref(), root_before.model.as_deref());
+    assert_eq!(root_after.model_provider_id, root_before.model_provider_id);
+    assert_eq!(
+        root_after.model_reasoning_effort,
+        root_before.model_reasoning_effort
+    );
+    assert_eq!(root_after.service_tier, root_before.service_tier);
+    assert_eq!(root_after.web_search_mode.value(), WebSearchMode::Cached);
+    Ok(())
+}
