+    let stored = child_thread
+        .read_thread(/*include_archived*/ true, /*include_history*/ false)
+        .await
+        .expect("child metadata should be readable");
+    assert_eq!(stored.model.as_deref(), Some(NATIVE_API_MODEL));
+    assert_eq!(stored.model_provider, provider_id);
+    child_thread
+        .shutdown_and_wait()
+        .await
+        .expect("child thread should shut down");
+    assert!(harness.manager.remove_thread(&child_id).await.is_some());
+
+    let mut sender_config = config.clone();
+    sender_config.model = Some("gpt-5.6-sol".to_string());
+    sender_config.model_provider_id = "openai".to_string();
+    sender_config.model_provider = sender_config
+        .model_providers
+        .get("openai")
+        .cloned()
+        .expect("openai provider should exist");
+    sender_config.model_reasoning_effort = Some(ReasoningEffort::XHigh);
+    sender_config.service_tier = Some("flex".to_string());
+    let _pin = Box::pin(control.ensure_v2_agent_loaded(
+        sender_config, child_id, /*parent*/ None,
+    ))
+    .await
+    .expect("non-reasoning API child should reload without an effort");
+
+    let resumed = harness
+        .manager
+        .get_thread(child_id)
+        .await
+        .expect("resumed child should exist");
+    let resumed_config = resumed.session.get_config().await;
+    assert_eq!(resumed_config.model_reasoning_effort, None);
+    assert_eq!(resumed_config.model.as_deref(), Some(NATIVE_API_MODEL));
+    assert_eq!(resumed_config.model_provider_id, provider_id);
+    assert_eq!(resumed_config.service_tier, None);
+    assert_eq!(
+        resumed_config.web_search_mode.value(),
+        WebSearchMode::Disabled
+    );
+    assert_eq!(
+        resumed.session_source.get_agent_role().as_deref(),
+        Some(role.as_str())
+    );
+
+    let root_after = root_thread.session.get_config().await;
+    assert_eq!(
+        root_after.model_reasoning_effort,
+        Some(ReasoningEffort::XHigh)
+    );
+    assert_eq!(root_after.service_tier, root_before.service_tier);
+    Ok(())
+}
