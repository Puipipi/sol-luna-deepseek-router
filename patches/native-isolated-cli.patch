--- /dev/null
+++ b/codex-rs/protocol/src/sol_luna_wire_aliases.rs
@@ -0,0 +1,504 @@
+use crate::models::ResponseItem;
+use serde_json::{Map, Value};
+
+const ENABLE_ENV: &str = "SOL_LUNA_NATIVE_PLAINTEXT_V2";
+const SOURCE_NAMESPACE: &str = "collaboration";
+const WIRE_NAMESPACE: &str = "collaboration-optimize";
+
+#[derive(Clone, Copy, Debug, Eq, PartialEq)]
+enum Direction {
+    Encode,
+    Decode,
+}
+
+fn mapped_namespace(namespace: &str, direction: Direction) -> Option<&'static str> {
+    match (namespace, direction) {
+        (SOURCE_NAMESPACE, Direction::Encode) => Some(WIRE_NAMESPACE),
+        (WIRE_NAMESPACE, Direction::Decode) => Some(SOURCE_NAMESPACE),
+        _ => None,
+    }
+}
+
+fn mapped_name(name: &str, direction: Direction) -> Option<&'static str> {
+    match (name, direction) {
+        ("spawn_agent", Direction::Encode) => Some("start_delegated_task"),
+        ("send_message", Direction::Encode) => Some("deliver_delegated_message"),
+        ("followup_task", Direction::Encode) => Some("continue_delegated_task"),
+        ("start_delegated_task", Direction::Decode) => Some("spawn_agent"),
+        ("deliver_delegated_message", Direction::Decode) => Some("send_message"),
+        ("continue_delegated_task", Direction::Decode) => Some("followup_task"),
+        _ => None,
+    }
+}
+
+fn mapped_flat_name(name: &str, direction: Direction) -> Option<String> {
+    let (namespace, function) = name.split_once('.')?;
+    let mapped_namespace = mapped_namespace(namespace, direction)?;
+    let mapped_function = mapped_name(function, direction).map_or(function, |mapped| mapped);
+    Some(format!("{mapped_namespace}.{mapped_function}"))
+}
+
+fn object_string<'a>(object: &'a Map<String, Value>, field: &str) -> Option<&'a str> {
+    object.get(field).and_then(Value::as_str)
+}
+
+fn remove_message_encrypted_marker(tool: &mut Value) {
+    let Some(message) = tool
+        .get_mut("parameters")
+        .and_then(Value::as_object_mut)
+        .and_then(|parameters| parameters.get_mut("properties"))
+        .and_then(Value::as_object_mut)
+        .and_then(|properties| properties.get_mut("message"))
+        .and_then(Value::as_object_mut)
+    else {
+        return;
+    };
+    message.remove("encrypted");
+}
+
+fn transform_function(tool: &mut Value, inherited_namespace: Option<&str>, direction: Direction) {
+    let mut remove_encrypted_marker = false;
+    {
+        let Some(object) = tool.as_object_mut() else { return };
+        if object_string(object, "type") != Some("function") { return }
+
+        let explicit_namespace = object_string(object, "namespace").map(str::to_string);
+        let effective_namespace = explicit_namespace.as_deref().or(inherited_namespace);
+        if let Some(namespace) = explicit_namespace.as_deref()
+            && let Some(mapped) = mapped_namespace(namespace, direction)
+        {
+            object.insert("namespace".to_string(), Value::String(mapped.to_string()));
+        }
+
+        let Some(name) = object_string(object, "name").map(str::to_string) else { return };
+        if let Some(namespace) = effective_namespace
+            && (namespace == SOURCE_NAMESPACE || namespace == WIRE_NAMESPACE)
+        {
+            if let Some(mapped) = mapped_name(&name, direction) {
+                object.insert("name".to_string(), Value::String(mapped.to_string()));
+                remove_encrypted_marker = direction == Direction::Encode;
+            }
+        } else if effective_namespace.is_none()
+            && let Some(mapped) = mapped_flat_name(&name, direction)
+        {
+            object.insert("name".to_string(), Value::String(mapped));
+            remove_encrypted_marker = direction == Direction::Encode
+                && name.split_once('.').is_some_and(|(_, function)| {
+                    mapped_name(function, direction).is_some()
+                });
+        }
+    }
+    if remove_encrypted_marker { remove_message_encrypted_marker(tool); }
+}
+
+fn projected_function_identity(
+    object: &Map<String, Value>,
+    inherited_namespace: Option<&str>,
+    direction: Direction,
+) -> Option<(String, String)> {
+    let name = object_string(object, "name")?;
+    let namespace = object_string(object, "namespace").or(inherited_namespace);
+    if let Some(namespace) = namespace {
+        let projected_namespace = mapped_namespace(namespace, direction).map_or(namespace, |mapped| mapped);
+        let projected_name = if namespace == SOURCE_NAMESPACE || namespace == WIRE_NAMESPACE {
+            mapped_name(name, direction).map_or(name, |mapped| mapped)
+        } else {
+            name
+        };
+        let original = format!("{namespace}.{name}");
+        return Some((format!("{projected_namespace}.{projected_name}"), original));
+    }
+    if let Some(projected) = mapped_flat_name(name, direction) {
+        return Some((projected, name.to_string()));
+    }
+    Some((name.to_string(), name.to_string()))
+}
+
+fn has_function_collision(tools: &[Value], direction: Direction) -> bool {
+    let mut identities = std::collections::HashMap::<String, String>::new();
+    for tool in tools {
+        let Some(object) = tool.as_object() else { continue };
+        match object_string(object, "type") {
+            Some("function") => {
+                if let Some((projected, original)) = projected_function_identity(object, None, direction) {
+                    if identities.insert(projected, original.clone())
+                        .is_some_and(|previous| previous != original)
+                    { return true; }
+                }
+            }
+            Some("namespace")
+                if object_string(object, "name").is_some_and(|name| {
+                    name == SOURCE_NAMESPACE || name == WIRE_NAMESPACE
+                }) =>
+            {
+                let namespace = object_string(object, "name");
+                if let Some(children) = object.get("tools").and_then(Value::as_array) {
+                    for child in children {
+                        let Some(child_object) = child.as_object() else { continue };
+                        if object_string(child_object, "type") != Some("function") { continue }
+                        if let Some((projected, original)) =
+                            projected_function_identity(child_object, namespace, direction)
+                        {
+                            if identities.insert(projected, original.clone())
+                                .is_some_and(|previous| previous != original)
+                            { return true; }
+                        }
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+    false
+}
+
+fn transform_tools(value: Value, direction: Direction) -> Result<Value, String> {
+    let mut tools = match value {
+        Value::Array(tools) => tools,
+        value => return Ok(value),
+    };
+    let (source_namespace, target_namespace) = match direction {
+        Direction::Encode => (SOURCE_NAMESPACE, WIRE_NAMESPACE),
+        Direction::Decode => (WIRE_NAMESPACE, SOURCE_NAMESPACE),
+    };
+    let has_source_namespace = tools.iter().any(|tool| {
+        tool.as_object().is_some_and(|object| {
+            object_string(object, "type") == Some("namespace")
+                && object_string(object, "name") == Some(source_namespace)
+        })
+    });
+    let has_target_namespace = tools.iter().any(|tool| {
+        tool.as_object().is_some_and(|object| {
+            object_string(object, "type") == Some("namespace")
+                && object_string(object, "name") == Some(target_namespace)
+        })
+    });
+    if has_source_namespace && has_target_namespace {
+        return Err(format!("both {source_namespace} and {target_namespace} tool namespaces are present"));
+    }
+    if has_function_collision(&tools, direction) {
+        return Err("both canonical and aliased collaboration tool names are present".to_string());
+    }
+
+    for tool in &mut tools {
+        let kind = tool.get("type").and_then(Value::as_str).map(str::to_string);
+        match kind.as_deref() {
+            Some("namespace") => {
+                let Some(object) = tool.as_object_mut() else { continue };
+                let Some(namespace) = object_string(object, "name").map(str::to_string) else { continue };
+                if namespace != source_namespace && namespace != target_namespace { continue }
+                if let Some(mapped) = mapped_namespace(&namespace, direction) {
+                    object.insert("name".to_string(), Value::String(mapped.to_string()));
+                }
+                if let Some(functions) = object.get_mut("tools").and_then(Value::as_array_mut) {
+                    let inherited_namespace = namespace.as_str();
+                    for function in functions {
+                        transform_function(function, Some(inherited_namespace), direction);
+                    }
+                }
+            }
+            Some("function") => transform_function(tool, None, direction),
+            _ => {}
+        }
+    }
+    Ok(Value::Array(tools))
+}
+
+/// Whether the native plaintext collaboration wire alias is explicitly enabled.
+pub fn enabled() -> bool {
+    std::env::var(ENABLE_ENV).is_ok_and(|value| value == "1")
+}
+
+/// Translate canonical collaboration tool identities to the DeepSeek wire namespace.
+pub fn encode_tools_json(tools: Value) -> Result<Value, String> {
+    transform_tools(tools, Direction::Encode)
+}
+
+fn transform_response_item(item: &mut ResponseItem, direction: Direction) -> Result<(), String> {
+    match item {
+        ResponseItem::AdditionalTools { tools, .. } => {
+            let transformed = transform_tools(Value::Array(tools.to_vec()), direction)?;
+            *tools = transformed.as_array().cloned().unwrap_or_default().into();
+        }
+        ResponseItem::FunctionCall { name, namespace, encrypted_function_args, .. } => {
+            let effective_namespace = namespace.as_deref().map(str::to_string);
+            let flat_wire_function = if direction == Direction::Decode
+                && effective_namespace.is_none()
+            {
+                name.split_once('.').and_then(|(namespace, function)| {
+                    (namespace == WIRE_NAMESPACE).then(|| function.to_string())
+                })
+            } else {
+                None
+            };
+            let is_wire_message_alias = direction == Direction::Decode
+                && match effective_namespace.as_deref() {
+                    Some(WIRE_NAMESPACE) => {
+                        mapped_name(name.as_str(), Direction::Decode).is_some()
+                    }
+                    None => flat_wire_function.as_deref().is_some_and(|function| {
+                        mapped_name(function, Direction::Decode).is_some()
+                    }),
+                    _ => false,
+                };
+            if let Some(value) = effective_namespace.as_deref()
+                && let Some(mapped) = mapped_namespace(value, direction)
+            {
+                *namespace = Some(mapped.to_string());
+            }
+            if let Some(value) = effective_namespace.as_deref()
+                && (value == SOURCE_NAMESPACE || value == WIRE_NAMESPACE)
+            {
+                if let Some(mapped) = mapped_name(name, direction) {
+                    *name = mapped.to_string();
+                }
+            } else if effective_namespace.is_none()
+                && let Some(function) = flat_wire_function
+            {
+                *namespace = Some(SOURCE_NAMESPACE.to_string());
+                *name = mapped_name(&function, direction).unwrap_or(&function).to_string();
+            } else if effective_namespace.is_none()
+                && let Some(mapped) = mapped_flat_name(name, direction)
+            {
+                *name = mapped;
+            }
+            if is_wire_message_alias && encrypted_function_args.is_none() {
+                *encrypted_function_args = Some(Vec::new());
+            }
+        }
+        _ => {}
+    }
+    Ok(())
+}
+
+/// Translate canonical response items to wire aliases without changing persisted history.
+pub fn encode_response_item(item: &mut ResponseItem) -> Result<(), String> {
+    transform_response_item(item, Direction::Encode)
+}
+
+/// Restore wire aliases before response items enter native event and history handling.
+pub fn decode_response_item(item: &mut ResponseItem) -> Result<(), String> {
+    transform_response_item(item, Direction::Decode)
+}
