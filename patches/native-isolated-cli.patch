+use crate::config::Config;
+use crate::config::Constrained;
+use codex_protocol::config_types::WebSearchMode;
+use codex_protocol::openai_models::ModelsResponse;
+use codex_protocol::openai_models::ReasoningEffort;
+use codex_model_provider_info::WireApi;
+use std::fs;
+use url::Url;
+
+pub(crate) const NATIVE_DEEPSEEK_ROLE_NAME: &str = "native_deepseek";
+pub(crate) const NATIVE_DEEPSEEK_PROVIDER_ID: &str = "deepseek-native";
+pub(crate) const NATIVE_DEEPSEEK_MODEL: &str = "deepseek/deepseek-flash";
+pub(crate) const NATIVE_DEEPSEEK_CATALOG_FILE: &str = "sol-luna-native-models.json";
+const NATIVE_API_ROLE_PREFIX: &str = "native_api_";
+const NATIVE_API_PROVIDER_PREFIX: &str = "api-native-";
+const NATIVE_API_CATALOG_PREFIX: &str = "sol-luna-native-models-";
+
+pub(crate) fn native_api_profile_hash(role_name: &str) -> Result<Option<&str>, String> {
+    let Some(hash) = role_name.strip_prefix(NATIVE_API_ROLE_PREFIX) else {
+        return Ok(None);
+    };
+    if hash.len() != 24 || !hash.bytes().all(|byte| byte.is_ascii_hexdigit() && !byte.is_ascii_uppercase()) {
+        return Err("native API role name must end in 24 lowercase hexadecimal characters".to_string());
+    }
+    Ok(Some(hash))
+}
+
+pub(crate) fn apply_native_deepseek_child_config(
+    config: &mut Config,
+    role_name: Option<&str>,
+    full_history_fork: bool,
+) -> Result<(), String> {
+    if role_name != Some(NATIVE_DEEPSEEK_ROLE_NAME) {
+        let Some(role_name) = role_name else {
+            return Ok(());
+        };
+        let Some(profile_hash) = native_api_profile_hash(role_name)? else {
+            return Ok(());
+        };
+        return apply_native_api_profile_child_config(config, role_name, profile_hash, full_history_fork);
+    }
+    if full_history_fork {
+        return Err("native_deepseek child does not support full-history forks".to_string());
+    }
+
+    let model = config.model.as_deref();
+    if model != Some(NATIVE_DEEPSEEK_MODEL) {
+        return Err(format!(
+            "native_deepseek role requires model `{NATIVE_DEEPSEEK_MODEL}`, got `{}`",
+            model.unwrap_or("<unset>")
+        ));
+    }
+
+    if let Some(required_provider) = config.config_layer_stack.required_model_provider()
+        && required_provider != NATIVE_DEEPSEEK_PROVIDER_ID
+    {
+        return Err(format!(
+            "native_deepseek child requires provider `{NATIVE_DEEPSEEK_PROVIDER_ID}`, but managed configuration requires `{required_provider}`"
+        ));
+    }
+
+    let provider = config
+        .model_providers
+        .get(NATIVE_DEEPSEEK_PROVIDER_ID)
+        .cloned()
+        .ok_or_else(|| {
+            format!(
+                "native_deepseek provider `{NATIVE_DEEPSEEK_PROVIDER_ID}` is not configured"
+            )
+        })?;
+    let catalog_path = config
+        .codex_home
+        .as_path()
+        .join(NATIVE_DEEPSEEK_CATALOG_FILE);
+    let bytes = fs::read(&catalog_path).map_err(|err| {
+        format!(
+            "failed to read native_deepseek child model catalog `{}`: {err}",
+            catalog_path.display()
+        )
+    })?;
+    let catalog: ModelsResponse = serde_json::from_slice(&bytes).map_err(|err| {
+        format!(
+            "failed to parse native_deepseek child model catalog `{}`: {err}",
+            catalog_path.display()
+        )
+    })?;
+    if !catalog.models.iter().any(|entry| entry.slug == NATIVE_DEEPSEEK_MODEL) {
+        return Err(format!(
+            "native_deepseek child model catalog must include `{NATIVE_DEEPSEEK_MODEL}`"
+        ));
+    }
+    if let Some(reasoning_effort) = config.model_reasoning_effort.as_ref() {
+        let model = catalog
+            .models
+            .iter()
+            .find(|entry| entry.slug == NATIVE_DEEPSEEK_MODEL)
+            .expect("catalog model was checked above");
+        if !model
+            .supported_reasoning_levels
+            .iter()
+            .any(|preset| &preset.effort == reasoning_effort)
+        {
+            let supported = model
+                .supported_reasoning_levels
+                .iter()
+                .map(|preset| preset.effort.to_string())
+                .collect::<Vec<_>>()
+                .join(", ");
+            return Err(format!(
+                "Reasoning effort `{reasoning_effort}` is not supported for model `{NATIVE_DEEPSEEK_MODEL}` in the native child catalog. Supported reasoning efforts: {supported}"
+            ));
+        }
+    }
+
+    config.model_provider_id = NATIVE_DEEPSEEK_PROVIDER_ID.to_string();
+    config.model_provider = provider;
+    config.model_catalog = Some(catalog);
+    Ok(())
+}
+
+fn apply_native_api_profile_child_config(
+    config: &mut Config,
+    role_name: &str,
+    profile_hash: &str,
+    full_history_fork: bool,
+) -> Result<(), String> {
+    if !config.agent_roles.contains_key(role_name) {
+        return Err(format!("native API profile role `{role_name}` is not registered"));
+    }
+    if full_history_fork {
+        return Err(format!("{role_name} does not support full-history forks"));
+    }
+    let provider_id = format!("{NATIVE_API_PROVIDER_PREFIX}{profile_hash}");
+    if let Some(required_provider) = config.config_layer_stack.required_model_provider()
+        && required_provider != provider_id
+    {
+        return Err(format!(
+            "{role_name} requires provider `{provider_id}`, but managed configuration requires `{required_provider}`"
+        ));
+    }
+    let provider = config.model_providers.get(&provider_id).cloned().ok_or_else(|| {
+        format!("{role_name} provider `{provider_id}` is not configured")
+    })?;
+    validate_native_api_provider(&provider, profile_hash, role_name)?;
+
+    let catalog_file = format!("{NATIVE_API_CATALOG_PREFIX}{profile_hash}.json");
+    let catalog_path = config.codex_home.as_path().join(&catalog_file);
+    let bytes = fs::read(&catalog_path).map_err(|err| {
+        format!("failed to read {role_name} model catalog `{}`: {err}", catalog_path.display())
+    })?;
+    let catalog: ModelsResponse = serde_json::from_slice(&bytes).map_err(|err| {
+        format!("failed to parse {role_name} model catalog `{}`: {err}", catalog_path.display())
+    })?;
+    let model_slug = config.model.as_deref().ok_or_else(|| {
+        format!("{role_name} requires a model selected by its profile catalog")
+    })?;
+    if catalog.models.len() != 1 || catalog.models[0].slug != model_slug {
+        return Err(format!(
+            "{role_name} catalog must contain exactly the configured model `{model_slug}`"
+        ));
+    }
+    // `parameter = "none"` profiles omit role effort and advertise no reasoning levels.
+    // Clear inherited/stored parent effort instead of validating a value this catalog cannot support.
+    if catalog.models[0].supported_reasoning_levels.is_empty()
+        && catalog.models[0].default_reasoning_level.is_none()
+    {
+        config.model_reasoning_effort = None;
+    }
+    if let Some(effort) = config.model_reasoning_effort.as_ref() {
+        validate_profile_reasoning_effort(role_name, &catalog, effort)?;
+    }
+    apply_native_api_web_search_policy(config, role_name)?;
+
+    config.model_provider_id = provider_id;
+    config.model_provider = provider;
+    config.model_catalog = Some(catalog);
+    Ok(())
+}
+
+fn validate_native_api_provider(
+    provider: &codex_model_provider_info::ModelProviderInfo,
+    profile_hash: &str,
+    role_name: &str,
+) -> Result<(), String> {
+    let invalid = || format!("{role_name} provider must be an unauthenticated HTTP-only local Responses gateway for this profile");
+    let Some(base_url) = provider.base_url.as_deref() else {
+        return Err(invalid());
+    };
+    let url = Url::parse(base_url).map_err(|_| invalid())?;
+    let path = url.path_segments().map(|segments| segments.collect::<Vec<_>>()).unwrap_or_default();
+    if url.scheme() != "http"
+        || url.host_str() != Some("127.0.0.1")
+        || url.port().is_none()
+        || !url.username().is_empty()
+        || url.password().is_some()
+        || url.query().is_some()
+        || url.fragment().is_some()
+        || path.len() != 4
+        || path[0].is_empty()
+        || path[1] != "profiles"
+        || path[2] != profile_hash
+        || path[3] != "v1"
+        || provider.wire_api != WireApi::Responses
+        || provider.requires_openai_auth
+        || provider.supports_websockets
+        || provider.env_key.is_some()
+        || provider.experimental_bearer_token.is_some()
+        || provider.auth.is_some()
+        || provider.gateway_oauth.is_some()
+        || provider.aws.is_some()
+        || provider.model_catalog_url.is_some()
+        || provider.query_params.is_some()
+        || provider.http_headers.is_some()
+        || provider.env_http_headers.is_some()
+    {
+        return Err(invalid());
+    }
+    Ok(())
+}
+
+pub(crate) fn apply_native_api_web_search_policy(
+    config: &mut Config,
+    role_name: &str,
+) -> Result<(), String> {
+    config
+        .web_search_mode
+        .can_set(&WebSearchMode::Disabled)
+        .map_err(|err| {
+            format!(
+                "{role_name} requires web_search disabled, but managed configuration disallows it: {err}"
+            )
+        })?;
+    // First-version profile children keep the hosted search tool off for every turn.
+    config.web_search_mode = Constrained::allow_only(WebSearchMode::Disabled);
+    Ok(())
+}
+
+pub(crate) fn validate_profile_reasoning_effort(
+    role_name: &str,
+    catalog: &ModelsResponse,
+    effort: &ReasoningEffort,
+) -> Result<(), String> {
+    let supported_levels = &catalog.models[0].supported_reasoning_levels;
+    if !supported_levels.iter().any(|preset| &preset.effort == effort) {
+        let supported = supported_levels
+            .iter()
+            .map(|preset| preset.effort.to_string())
+            .collect::<Vec<_>>()
+            .join(", ");
+        return Err(format!(
+            "Reasoning effort `{effort}` is not supported for {role_name}. Supported reasoning efforts: {supported}"
+        ));
+    }
+    Ok(())
+}
+
