+async fn native_api_cold_resume_keeps_stored_profile_and_clears_sender_service_tier_impl() -> anyhow::Result<()> {
+    let (home, mut config) = test_config().await;
+    let _ = config.features.enable(Feature::MultiAgentV2);
+    let _ = config.features.enable(Feature::Sqlite);
+    config.model = Some("gpt-5.6-sol".to_string());
+    config.model_reasoning_effort = Some(ReasoningEffort::XHigh);
+    config.service_tier = Some("flex".to_string());
+    config.web_search_mode = Constrained::allow_any(WebSearchMode::Cached);
+    config.multi_agent_v2.max_concurrent_threads_per_session = 3;
+    config.permissions.allow_login_shell = true;
+    config
+        .permissions
+        .set_permission_profile(PermissionProfile::read_only())
+        .expect("read-only parent profile");
+    let (role, provider_id, catalog, provider) =
+        configure_native_api_profile(&home, &mut config, NATIVE_API_MODEL, Some("medium"), true);
+    let home_path = home.path().to_path_buf();
+    let harness = AgentControlHarness::new_with_config(home, config.clone()).await;
+    let (_root_id, root_thread) = harness.start_paginated_thread().await;
+    let root_before = root_thread.session.get_config().await;
+    assert_eq!(root_before.service_tier.as_deref(), Some("flex"));
+    assert_eq!(root_before.web_search_mode.value(), WebSearchMode::Cached);
+    let control = root_thread
+        .session
+        .services
+        .local_agent_runtime
+        .control(root_thread.session.session_id());
+
+    let mut child_config = config.clone();
+    child_config.model = Some(NATIVE_API_MODEL.to_string());
+    child_config.model_provider_id = provider_id.clone();
+    child_config.model_provider = provider.clone();
+    child_config.model_catalog = Some(catalog.clone());
+    child_config.model_reasoning_effort = Some(ReasoningEffort::High);
+    child_config.service_tier = Some("flex".to_string());
+    let child = spawn_v2_reload_test_child_with_role(
+        &control,
+        child_config,
+        &root_thread,
+        "worker",
+        Some(&role),
+    )
+    .await;
+    let child_id = child.thread_id;
+    let child_thread = harness
+        .manager
+        .get_thread(child_id)
+        .await
+        .expect("child thread should exist");
+    persist_thread_for_tree_resume(&child_thread, "native API child persisted").await;
+    let stored = child_thread
+        .read_thread(/*include_archived*/ true, /*include_history*/ false)
+        .await
+        .expect("child metadata should be readable");
+    assert_eq!(stored.model.as_deref(), Some(NATIVE_API_MODEL));
+    assert_eq!(stored.model_provider, provider_id);
+    assert_eq!(stored.reasoning_effort, Some(ReasoningEffort::High));
+    child_thread
+        .shutdown_and_wait()
+        .await
+        .expect("child thread should shut down");
+    assert!(harness.manager.remove_thread(&child_id).await.is_some());
+
+    // Changing the role file after spawn must not rewrite the old child's model or effort.
+    write_native_api_role(
+        &home_path.join("agents").join(format!("{role}.toml")),
+        &role,
+        "vendor/role-default-changed",
+        Some("low"),
+    );
+
+    let mut sender_config = config.clone();
+    sender_config.model = Some("gpt-5.6-sol".to_string());
+    sender_config.model_provider_id = "openai".to_string();
+    sender_config.model_provider = sender_config
+        .model_providers
+        .get("openai")
+        .cloned()
+        .expect("openai provider should exist");
+    sender_config.model_reasoning_effort = Some(ReasoningEffort::XHigh);
+    sender_config.service_tier = Some("flex".to_string());
+    let _pin = Box::pin(control.ensure_v2_agent_loaded(
+        sender_config, child_id, /*parent*/ None,
+    ))
+    .await
+    .expect("stored native API child should reload");
+
+    let resumed = harness
+        .manager
+        .get_thread(child_id)
+        .await
+        .expect("resumed child should exist");
+    let resumed_config = resumed.session.get_config().await;
+    let expected_base_url = native_api_base_url();
+    assert_eq!(resumed_config.model.as_deref(), Some(NATIVE_API_MODEL));
+    assert_eq!(resumed_config.model_provider_id, provider_id);
+    assert_eq!(
+        resumed_config.model_provider.base_url.as_deref(),
+        Some(expected_base_url.as_str())
+    );
+    assert_eq!(
+        resumed_config.model_reasoning_effort,
+        Some(ReasoningEffort::High)
+    );
+    assert_eq!(resumed_config.service_tier, None);
+    assert_eq!(
+        resumed_config.web_search_mode.value(),
+        WebSearchMode::Disabled
+    );
+    assert_eq!(
+        resumed_config.model_catalog.as_ref().unwrap().models[0].slug,
+        NATIVE_API_MODEL
+    );
+    assert_eq!(
+        resumed.session_source.get_agent_role().as_deref(),
+        Some(role.as_str())
+    );
+
+    let root_after = root_thread.session.get_config().await;
+    assert_eq!(root_after.model.as_deref(), root_before.model.as_deref());
+    assert_eq!(root_after.model_provider_id, root_before.model_provider_id);
+    assert_eq!(
+        root_after.model_reasoning_effort,
+        root_before.model_reasoning_effort
+    );
+    assert_eq!(root_after.service_tier, root_before.service_tier);
+    assert_eq!(root_after.web_search_mode.value(), WebSearchMode::Cached);
+    Ok(())
+}
