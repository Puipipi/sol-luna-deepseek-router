+const NATIVE_API_HASH: &str = "0123456789abcdef01234567";
+const NATIVE_API_MODEL: &str = "vendor/custom-model";
+
+fn native_api_role() -> String {
+    format!("native_api_{NATIVE_API_HASH}")
+}
+
+fn native_api_provider_id() -> String {
+    format!("api-native-{NATIVE_API_HASH}")
+}
+
+fn native_api_base_url() -> String {
+    format!("http://127.0.0.1:43210/token/profiles/{NATIVE_API_HASH}/v1")
+}
+
+fn write_native_api_role(
+    path: &std::path::Path,
+    role: &str,
+    model: &str,
+    effort: Option<&str>,
+) {
+    let mut contents = format!("name = {role:?}\nmodel = {model:?}\n");
+    if let Some(effort) = effort {
+        contents.push_str(&format!("model_reasoning_effort = {effort:?}\n"));
+    }
+    contents.push_str("\n[features]\nunbounded_connection_retries = false\n");
+    std::fs::write(path, contents).expect("write native API role");
+}
+
+fn configure_native_api_profile(
+    home: &TempDir,
+    config: &mut Config,
+    role_model: &str,
+    role_effort: Option<&str>,
+    reasoning_supported: bool,
+) -> (String, String, ModelsResponse, ModelProviderInfo) {
+    let role = native_api_role();
+    let provider_id = native_api_provider_id();
+    let role_dir = home.path().join("agents");
+    std::fs::create_dir_all(&role_dir).expect("create native API role dir");
+    let role_path = role_dir.join(format!("{role}.toml"));
+    write_native_api_role(&role_path, &role, role_model, role_effort);
+    config.agent_roles.insert(
+        role.clone(),
+        AgentRoleConfig {
+            description: Some("Native API test role".to_string()),
+            config_file: Some(role_path),
+            nickname_candidates: None,
+        },
+    );
+
+    let mut model = model_info_from_slug(NATIVE_API_MODEL);
+    if reasoning_supported {
+        model.supported_reasoning_levels = vec![
+            ReasoningEffortPreset {
+                effort: ReasoningEffort::Low,
+                description: "Low effort".to_string(),
+            },
+            ReasoningEffortPreset {
+                effort: ReasoningEffort::Medium,
+                description: "Medium effort".to_string(),
+            },
+            ReasoningEffortPreset {
+                effort: ReasoningEffort::High,
+                description: "High effort".to_string(),
+            },
+        ];
+        model.default_reasoning_level = Some(ReasoningEffort::Medium);
+    } else {
+        model.supported_reasoning_levels = Vec::new();
+        model.default_reasoning_level = None;
+        model.multi_agent_reasoning_effort = None;
+    }
+    model.context_window = Some(64_000);
+    model.max_context_window = Some(64_000);
+    let catalog = ModelsResponse { models: vec![model] };
+    std::fs::write(
+        home.path()
+            .join(format!("sol-luna-native-models-{NATIVE_API_HASH}.json")),
+        serde_json::to_vec(&catalog).expect("serialize native API catalog"),
+    )
+    .expect("write native API catalog");
+
+    let mut provider = ModelProviderInfo::default();
+    provider.name = "Native API test provider".to_string();
+    provider.base_url = Some(native_api_base_url());
+    provider.wire_api = WireApi::Responses;
+    provider.requires_openai_auth = false;
+    provider.supports_websockets = false;
+    config
+        .model_providers
+        .insert(provider_id.clone(), provider.clone());
+
+    (role, provider_id, catalog, provider)
+}
