+/// Selects the model manager at the `spawn_thread` boundary.
+///
+/// Ordinary root, Sol, and Luna sessions keep sharing the root manager. A
+/// Native provider roles own their provider and catalog, so they must use a
+/// manager built from that child config instead of inheriting root metadata.
+fn select_models_manager_for_session(
+    config: &Config,
+    auth_manager: Arc<AuthManager>,
+    root_models_manager: SharedModelsManager,
+    session_source: &SessionSource,
+) -> CodexResult<SharedModelsManager> {
+    let role_name = session_source.get_agent_role();
+    if role_name.as_deref() == Some(NATIVE_DEEPSEEK_ROLE_NAME) {
+        if config.model_provider_id != NATIVE_DEEPSEEK_PROVIDER_ID
+            || !config
+                .model_providers
+                .contains_key(NATIVE_DEEPSEEK_PROVIDER_ID)
+        {
+            return Err(CodexErr::InvalidRequest(format!(
+                "native_deepseek child requires provider `{NATIVE_DEEPSEEK_PROVIDER_ID}`"
+            )));
+        }
+        if !config.model_catalog.as_ref().is_some_and(|catalog| {
+            catalog
+                .models
+                .iter()
+                .any(|model| model.slug == NATIVE_DEEPSEEK_MODEL)
+        }) {
+            return Err(CodexErr::InvalidRequest(format!(
+                "native_deepseek child catalog must include `{NATIVE_DEEPSEEK_MODEL}`"
+            )));
+        }
+        return Ok(build_models_manager(config, auth_manager));
+    }
+
+    let Some(role_name) = role_name else {
+        return Ok(root_models_manager);
+    };
+    let profile_hash = native_api_profile_hash(&role_name)
+        .map_err(CodexErr::InvalidRequest)?;
+    let Some(profile_hash) = profile_hash else {
+        return Ok(root_models_manager);
+    };
+    let provider_id = format!("api-native-{profile_hash}");
+    if config.model_provider_id != provider_id || !config.model_providers.contains_key(&provider_id) {
+        return Err(CodexErr::InvalidRequest(format!(
+            "{role_name} child requires provider `{provider_id}`"
+        )));
+    }
+    let model = config.model.as_deref().ok_or_else(|| {
+        CodexErr::InvalidRequest(format!("{role_name} child requires its profile model"))
+    })?;
+    if !config.model_catalog.as_ref().is_some_and(|catalog| {
+        catalog.models.len() == 1 && catalog.models[0].slug == model
+    }) {
+        return Err(CodexErr::InvalidRequest(format!(
+            "{role_name} child catalog must contain exactly configured model `{model}`"
+        )));
+    }
+    Ok(build_models_manager(config, auth_manager))
+}
